DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rideshareapp?schema=public"
PORT=3000

# Stripe — TEST MODE ONLY. Use keys from your Stripe Dashboard's "Test mode"
# toggle (they start with sk_test_/pk_test_). Never put a live (sk_live_/
# pk_live_) key here or anywhere else in this repo. If unset, ride completion
# still works; the Stripe charge step is skipped with a logged warning (see
# src/modules/payments/ride-fare-payment.ts).
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
